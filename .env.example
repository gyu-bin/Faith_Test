# 카카오페이 (결제 연동 시)
KAKAO_PAY_CID=
KAKAO_PAY_SECRET_KEY=

# 배포 URL (OG 이미지·공유 링크)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 카카오 JS SDK (공유 — 없으면 Web Share / 링크 복사)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 참여자 수 (Vercel Marketplace → Upstash Redis 연동 시 자동 주입)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (구 Vercel KV 연동 시) KV_REST_API_URL= / KV_REST_API_TOKEN=
